{
  "name": "lumen-kb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Internal knowledge base with an embeddable in-app prompt and help snippet",
  "scripts": {
    "dev": "concurrently -n api,embed -c blue,green \"npm:dev:server\" \"npm:dev:embed\"",
    "dev:server": "tsx watch --ignore client --ignore embed server/index.ts",
    "dev:embed": "node scripts/build-embed.mjs --watch",
    "build": "vite build && node scripts/build-embed.mjs && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/server/index.js && cp -r server/db/migrations dist/server/",
    "start": "NODE_ENV=production node dist/server/index.js",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx server/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "build:embed": "node scripts/build-embed.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@electric-sql/pglite": "^0.5.15",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "marked": "^18.1.3",
    "pg": "^8.23.1",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  }
}