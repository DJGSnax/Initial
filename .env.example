# Postgres connection. Leave unset to use the embedded PGlite database in ./data/pglite
# DATABASE_URL=postgres://user:pass@host:5432/lumen

PORT=5174
# Public URL where this server is reachable (used in the install snippet)
PUBLIC_URL=http://localhost:5174

# Secret used to sign admin sessions and preview tokens. Generate with: openssl rand -hex 32
APP_SECRET=change-me

# Server-side pepper applied to every visitor id before it is stored.
# Changing it unlinks all existing analytics from future visitors. openssl rand -hex 32
VISITOR_PEPPER=change-me-too

# Optional: seed the first admin account on boot (otherwise use the /admin/setup screen)
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=a-long-password

# Optional: bearer token for the privacy automation API (erasure / access requests)
# PRIVACY_API_TOKEN=

# AI answers and nudges. Without a key, search still works and AI features switch off.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
